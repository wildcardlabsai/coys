# ===========================================
# COYS - Your Spurs Matchday Companion
# Environment Variables
# ===========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Football Data API (Sportmonks)
SPORTMONKS_API_KEY=your-sportmonks-api-key
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your-openweather-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=COYS
NODE_ENV=development

# Admin
ADMIN_EMAIL=admin@coys.app
